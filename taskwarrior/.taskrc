# [Created by task 3.4.1 5/17/2025 10:52:52]
data.location=/Users/gpalmer-bryant/.task
default.project=MC
default.due=today
news.version=3.4.1

# To use the default location of the XDG directories,
# move this configuration file from ~/.taskrc to ~/.config/task/taskrc and update location config as follows:

#data.location=~/.local/share/task
#hooks.location=~/.config/task/hooks

# Color theme (uncomment one to use)
#include light-16.theme
#include light-256.theme
#include bubblegum-256.theme
#include dark-16.theme
#include dark-256.theme
#include dark-red-256.theme
#include dark-green-256.theme
#include dark-blue-256.theme
#include dark-violets-256.theme
#include dark-yellow-green.theme
#include dark-gray-256.theme
#include dark-gray-blue-256.theme
#include solarized-dark-256.theme
#include solarized-light-256.theme
#include no-color.theme
include ~/.dotfiles/taskwarrior/personal.theme

uda.reviewed.type=date
uda.reviewed.label=Reviewed
uda.details.type=string
uda.details.label=Details
uda.priority.default=M

uda.taskwarrior-tui.shortcuts.1=~/.dotfiles/taskwarrior/task_wait_1h.sh
uda.taskwarrior-tui.shortcuts.2=~/.dotfiles/taskwarrior/task_wait_3.5h.sh
uda.taskwarrior-tui.shortcuts.3=~/.dotfiles/taskwarrior/task_wait_1d.sh

report._reviewed.description=Tasksh review report.  Adjust the filter to your needs.
report._reviewed.columns=uuid
report._reviewed.sort=reviewed+,modified+
report._reviewed.filter=( reviewed.none: or reviewed.before:now-6days ) and ( +PENDING or +WAITING )

verbose=blank,footnote,label,new-id,new-uuid,affected,edit,special,project,sync,override,unwait,context

urgency.blocking.coefficient=1
urgency.blocked.coefficient=-0.1
urgency.annotations.coefficient=0

# Prevent all tags from increasing urgency (default is 1.0 per tag)
urgency.tags.coefficient=0

# Lower urgency for non deliverable projects
urgency.uda.project.Training.coefficient=-1.0
urgency.uda.project.Personal.coefficient=-1.0
urgency.uda.project.TeamStuff.coefficient=-1.0

context.TeamStuff.read=project:TeamStuff
context.TeamStuff.write=project:TeamStuff
context.HR.read=project:HR
context.HR.write=project:HR
context.Personal.read=project:Personal
context.Personal.write=project:Personal
context.Training.read=project:Training
context.Training.write=project:Training
context.Misc.read=project:Misc
context.Misc.write=project:Misc
context.JiraBot.read=project:JiraBot
context.JiraBot.write=project:JiraBot
context.MC.read=project:MC
context.MC.write=project:MC
context.Obsidian.read=project:Obsidian
context.Obsidian.write=project:Obsidian
